{
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "name": "think-alive",
  "main": "src/server.ts",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "MyAgent",
        "name": "MyAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["MyAgent"],
      "tag": "v1"
    }
  ]
}
